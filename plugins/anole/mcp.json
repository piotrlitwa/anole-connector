{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "anole": {
      "type": "streamable-http",
      "url": "https://anole.app/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["anole:read"],
            "defaultScopes": ["anole:read", "anole:write"]
          }
        }
      }
    }
  }
}
